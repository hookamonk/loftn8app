# Copy to server/.env.docker and fill in REAL values. That file is gitignored —
# never commit it: it holds the secrets that sign guest and staff sessions.
#
# Generate the three JWT secrets (each different, >= 20 chars):
#   openssl rand -hex 32
# Generate the VAPID pair for staff push notifications:
#   cd server && npm run push:keys

NODE_ENV=production
PORT=4000

# Single-origin deploy behind Caddy. CORS allows same-origin automatically;
# add extra browser origins here (comma-separated) if called cross-origin.
FRONTEND_ORIGIN=http://localhost

DATABASE_URL=postgresql://loftn8:loftn8pass@db:5432/loftn8?schema=public

JWT_GUEST_SESSION_SECRET=replace_me_with_openssl_rand_hex_32
JWT_USER_SECRET=replace_me_with_a_DIFFERENT_random_value
JWT_STAFF_SECRET=replace_me_with_a_THIRD_random_value

COOKIE_DOMAIN=

# Staff logins created by `npm run prisma:seed` (first run only).
STAFF_ZIZKOV_WAITER_USERNAME=zizkov_waiter
STAFF_ZIZKOV_WAITER_PASSWORD=replace_me_strong
STAFF_ZIZKOV_HOOKAH_USERNAME=zizkov_hookah
STAFF_ZIZKOV_HOOKAH_PASSWORD=replace_me_strong
STAFF_ZIZKOV_MANAGER_USERNAME=zizkov_manager
STAFF_ZIZKOV_MANAGER_PASSWORD=replace_me_strong

# Staff push notifications.
VAPID_PUBLIC_KEY=replace_me_vapid_public_key
VAPID_PRIVATE_KEY=replace_me_vapid_private_key
VAPID_SUBJECT=mailto:admin@loftn8.cz

# Guest sign-up codes are e-mailed, so registration does not work without SMTP.
# Verify with: npm run mail:check you@example.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LOFT№8
